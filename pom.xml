                </plugin>
                <plugin>
                    <groupId>com.github.bringking</groupId>
                    <artifactId>requirejs-maven-plugin</artifactId>
                    <version>2.0.4</version>
                </plugin>
				<plugin>
					<groupId>org.eclipse.jetty</groupId>
					<artifactId>jetty-maven-plugin</artifactId>
					<version>11.0.25</version>
					<dependencies>
						<!-- H2 Database -->
						<dependency>
							<groupId>com.h2database</groupId>
							<artifactId>h2</artifactId>
							<version>2.2.224</version> <!-- 更新 H2 版本 -->
							<scope>runtime</scope>
						</dependency>
						<!-- C3P0 Connection Pool -->
						<dependency>
							<groupId>com.mchange</groupId>
							<artifactId>c3p0</artifactId>
							<version>0.9.5.5</version>
						</dependency>
						<dependency>
							<groupId>org.eclipse.jetty</groupId>
							<artifactId>jetty-maven-plugin</artifactId>
							<version>11.0.25</version>
						</dependency>
						<!--<dependency>
							<groupId>javax.servlet</groupId>
							<artifactId>javax.servlet-api</artifactId>
							<version>4.0.1</version>
						</dependency>-->
					</dependencies>
					<configuration>

						<!-- Web Application Source Directory -->
						<!--<webAppSourceDirectory>
							${project.basedir}/cap-web/target/cap-web-5.0.1-tcb-202503241400/
						</webAppSourceDirectory>-->

						<!-- Hot Deployment Scanning -->
						<scan>5</scan>
						<scanClassesPattern>
							<includes>
								<include>./**/target/*.jar</include>
								<!--<include>/Volumes/OSX/@Project/IISI_GIT_CAP4/CAP4_SOURCE/IISI_CAP4/cap-auth-admin/target/**</include>
								<include>/Volumes/OSX/@Project/IISI_GIT_CAP4/CAP4_SOURCE/IISI_CAP4/cap-batch/target/**</include>
								<include>/Volumes/OSX/@Project/IISI_GIT_CAP4/CAP4_SOURCE/IISI_CAP4/cap-core/target/**</include>
								<include>/Volumes/OSX/@Project/IISI_GIT_CAP4/CAP4_SOURCE/IISI_CAP4/cap-db/target/**</include>
								<include>/Volumes/OSX/@Project/IISI_GIT_CAP4/CAP4_SOURCE/IISI_CAP4/cap-hg/target/**</include>
								<include>/Volumes/OSX/@Project/IISI_GIT_CAP4/CAP4_SOURCE/IISI_CAP4/cap-mvc/target/**</include>
								<include>/Volumes/OSX/@Project/IISI_GIT_CAP4/CAP4_SOURCE/IISI_CAP4/cap-security/target/**</include>-->
							</includes>
						</scanClassesPattern>
						<scanTargetPatterns>
							<scanTargetPattern>
								<directory>${basedir}</directory>
								<includes>
									<include>**/**/*.xml</include>
									<include>**/**/*.properties</include>
								</includes>
							</scanTargetPattern>
						</scanTargetPatterns>

						<!-- Web Application Configuration -->
						<webApp>
							<!-- Path to web.xml -->
							<descriptor>
								${basedir}/src/main/webapp/WEB-INF/web.xml
							</descriptor>

							<!-- Path to jetty-env.xml -->
							<jettyEnvXml>
								${basedir}/src/main/webapp/WEB-INF/jetty-env.xml
							</jettyEnvXml>

							<!-- Context Path -->
							<contextPath>/cap-web</contextPath>
						</webApp>
						<httpConnector>
						    <port>8088</port>
						</httpConnector>

						<!-- Classes Directory -->
						<classesDirectory>
							${basedir}/target/cap-web-5.0.1-tcb-202503241400/WEB-INF/classes</classesDirectory>

						<!-- Context XML -->
						<contextXml>
							${basedir}/src/main/webapp/WEB-INF/jetty-env.xml</contextXml>

						<!-- Annotation Scanning Timeout -->
						<systemProperties>
							<property>
								<name>org.eclipse.jetty.annotations.maxWait</name>
								<value>300</value>
							</property>
						</systemProperties>				
		        	</configuration>
				</plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-eclipse-plugin</artifactId>
                <version>2.10</version>
