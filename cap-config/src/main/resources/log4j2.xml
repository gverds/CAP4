<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="debug">
    <Properties>
        <Property name="console-appender">console</Property>
        <Property name="basePath">D:/cap/logs</Property>
    </Properties>
    <Appenders>
        <RollingFile name="fileLogger" fileName="${basePath}/cap-log.log" filePattern="${basePath}/${date:yyyy-MM}/cap-log-%d{yyyy-MM-dd}-%i.log.zip">
            <PatternLayout pattern="%d [%t][%X{sessionId}]| %X{uuid} | %X{login} | %X{reqURI} | %-50.50c{1} [%-5p] %m%n" />
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="50 MB" />
            </Policies>
            <DefaultRolloverStrategy compressionLevel="9" max="100" />
        </RollingFile>
        <!-- <Console name="console-ft/" target="SYSTEM_OUT"> -->
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d [%t][%X{sessionId}]| %X{uuid} | %X{login} | %X{reqURI} | %-50.50c{1} [%-5p] %m%n" />
        </Console>
    </Appenders>
    <Loggers>
        <Root level="trace">
            <AppenderRef ref="${console-appender}" />
            <AppenderRef ref="fileLogger" />
        </Root>
        <!-- <Logger name="org" level="debug" />
        <Logger name="net" level="debug" /> -->
        <Logger name="com.iisigroup.cap.web.CapHandlerServlet" level="trace" />
        <Logger name="com.tcb.ecol.api.command.impl" level="debug" />
        <!-- 
        <Logger name="com.iisigroup.cap.utils.CapBeanUtil" level="trace" />
        <Logger name="com.iisigroup.cap.jdbc.CapNamedJdbcTemplate" level="trace" />
         -->
        <!-- transaction -->
        <Logger name="org.springframework.transaction" level="debug" />
        <!-- hibernate & cache -->
        <Logger name="org.hibernate" level="warn" />
        <!-- <Logger name="net.sf.ehcache" level="error" />
        <Logger name="org.hibernate.SQL" level="error" />
        <Logger name="org.hibernate.type" level="error" /> -->
        <!-- others -->
        <Logger name="org.springframework.security" level="debug" />
        <Logger name="org.apache.commons" level="warn" />
        <!-- <Logger name="org.springframework" level="debug" /> -->
        <Logger name="com.mchange.v2" level="debug" />
        <Logger name="springfox" level="debug" />
        <!-- sas 
        <Logger name="com.tcb.ecol.manager.command.sas.impl" level="error" />
        -->
        <Logger name="com.tcb.ecol.report.service.impl" level="debug" />
    </Loggers>
</Configuration>