<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn">
    <Properties>
        <Property name="console-appender">console</Property>
        <Property name="basePath">D:/cap/logs</Property>
        <!-- 查詢個資文件日誌 -->
        <property name="LOG_HOME">D:/cap/pii_logs</property>
        <!-- 日誌備份目錄 -->
        <property name="SERVER_NAME">PersonalInformation_log</property>
    </Properties>
    <Appenders>
        <RollingFile name="fileLogger" fileName="${basePath}/cap-log.log" filePattern="${basePath}/${date:yyyy-MM}/cap-log-%d{yyyy-MM-dd}-%i.log.zip">
            <PatternLayout pattern="%d [%t][%X{sessionId}]| %X{uuid} | %X{login} | %X{reqURI} | %-28.28c{1} [%-5p] %m%n" />
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="50 MB" />
            </Policies>
            <DefaultRolloverStrategy compressionLevel="9" max="100" />
        </RollingFile>
        <!-- <Console name="console-ft/" target="SYSTEM_OUT"> -->
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d [%t][%X{sessionId}]| %X{uuid} | %X{login} | %X{reqURI} | %-28.28c{1} [%-5p] %m%n" />
        </Console>
        <!-- 查詢個資文件日誌 -->
        <RollingFile name="piiLogger" fileName="${LOG_HOME}/${hostName}/${date:yyyy-MM}/eloan_PIILog.log"
                     filePattern="${LOG_HOME}/$${hostName}/$${date:yyyy-MM-dd}/eloan_PIILog-%d{yyyy-MM-dd}-%i.log.zip">
            <PatternLayout pattern="%d [%t] [%X{sessionId}] | %X{piiseq} | %X{login} | %X{uname} | %-28.28c{1} [%-5p] %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="50 MB" />
            </Policies>
            <DefaultRolloverStrategy compressionLevel="9" max="100" />
            <!-- <Policies>
                <TimeBasedTriggeringPolicy/>
                <OnStartupTriggeringPolicy/>
                每天晚上12點、05秒rolling一次
                <CronTriggeringPolicy schedule="0 0 0 * * ?"/>
                檔案到達10MB rolling一次
                <SizeBasedTriggeringPolicy size="50 MB"/>
            </Policies> -->
        </RollingFile>
    </Appenders>
    <Loggers>
        <Root level="debug">
            <AppenderRef ref="console" />
            <!-- <AppenderRef ref="${console-appender}"/> -->
            <AppenderRef ref="fileLogger" />
        </Root>
        <Logger name="org" level="error" />
        <Logger name="net" level="error" />
        <Logger name="com.iisigroup.cap.web.CapHandlerServlet" level="debug" />
        <Logger name="com.tcb.ecol.api.command.impl" level="debug" />
        <!-- 
        <Logger name="com.iisigroup.cap.utils.CapBeanUtil" level="trace" />
        <Logger name="com.iisigroup.cap.jdbc.CapNamedJdbcTemplate" level="trace" />
         -->
        <!-- transaction -->
        <Logger name="org.springframework.transaction" level="warn" />
        <Logger name="org.springframework.orm.hibernate5" level="warn" />
        <!-- hibernate & cache -->
        <Logger name="org.hibernate" level="error" />
        <Logger name="net.sf.ehcache" level="error" />
        <Logger name="org.hibernate.SQL" level="error" />
        <Logger name="org.hibernate.type" level="error" />
        <!-- others -->
        <Logger name="org.springframework.security" level="error" />
        <Logger name="org.apache.commons" level="warn" />
        <Logger name="org.springframework" level="debug" />
        <Logger name="com.mchange.v2" level="error" />
        <Logger name="springfox" level="error" />
        <!-- sas 
        <Logger name="com.tcb.ecol.manager.command.sas.impl" level="error" />
        -->
        <Logger name="com.tcb.ecol.report.service.impl" level="debug" />
        <!-- 查詢個資文件日誌 -->
        <Logger name="com.iisigroup.cap.jdbc.CapNamedJdbcTemplate.piiLogger" level="INFO">
          <!-- <AppenderRef ref="fileLogger"/> -->
          <AppenderRef ref="piiLogger"/>
        </Logger>
        <!-- 查詢個資文件日誌 -->
        <Logger name="com.iisigroup.cap.base.aop.EloanAuditLog4HandlerAdvice.piiLogger" level="INFO">
          <!-- <AppenderRef ref="fileLogger"/> -->
          <AppenderRef ref="piiLogger"/>
        </Logger>
        <Logger name="com.iisigroup.cap.db.dao.impl.GenericDaoImpl.piiLogger" level="INFO">
          <!-- <AppenderRef ref="fileLogger"/> -->
          <AppenderRef ref="piiLogger"/>
        </Logger>
        <Logger name="piiLogger.com.fcb" level="INFO">
          <!-- <AppenderRef ref="fileLogger"/> -->
          <AppenderRef ref="piiLogger"/>
        </Logger>
    </Loggers>
</Configuration>